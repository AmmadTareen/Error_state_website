<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ metaTitle or (title ~ " | Error State") }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#F7F7F7">
<link rel="canonical" href="{{ site.url }}{{ canonical or page.url }}">
<meta property="og:title" content="{{ metaTitle or (title ~ " | Error State") }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ canonical or page.url }}">
<meta property="og:type" content="{{ ogType or "website" }}">
{%- if ogImage %}
<meta property="og:image" content="{{ ogImage | absoluteUrl }}">
<meta property="og:image:alt" content="{{ ogImageAlt }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="alternate" type="application/rss+xml" title="Error State blog" href="{{ site.url }}/blog/rss.xml">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
<script src="/assets/js/theme.js"></script>
{%- if schema %}
<script type="application/ld+json">{{ schema | safe }}</script>
{%- endif %}
</head>
<body>

<a class="skip" href="#main">Skip to content</a>

<header class="hdr">
  <div class="hdr__in">
    <a class="brand" href="/" aria-label="Error State, home">
      <img class="brand__logo brand__full is-light" src="/assets/brand/logo-light.svg" alt="Error State" width="293" height="56">
      <img class="brand__logo brand__full is-dark" src="/assets/brand/logo-dark.svg" alt="" aria-hidden="true" width="293" height="56">
      <img class="brand__logo brand__mark is-light" src="/assets/brand/mark-light.svg" alt="Error State" width="21" height="21">
      <img class="brand__logo brand__mark is-dark" src="/assets/brand/mark-dark.svg" alt="" aria-hidden="true" width="21" height="21">
    </a>
    <nav class="nav" aria-label="Main">
      <a href="/work/">Work</a>
      <a href="/services/">Services</a>
      <a href="/process/">Process</a>
      <a href="/blog/" aria-current="page">Blog</a>
      <a href="/about/">About</a>
    </nav>
    <button class="menu-btn" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
      <span class="menu-ico" aria-hidden="true"></span>
    </button>
    <button class="theme" id="themeBtn" type="button" aria-label="Switch to dark mode">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2"/><path d="M12 2.4v2.2M12 19.4v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.4 12h2.2M19.4 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6"/>
      </svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z"/>
      </svg>
    </button>
    <a class="btn btn--primary btn--s" href="/book/?from=header" data-book="header"><span>Book a<span class="hide-xs"> 30 minute</span> call</span></a>
  </div>
</header>
<div class="menu" id="menu">
  <a href="/work/">Work</a>
  <a href="/services/">Services</a>
  <a href="/process/">Process</a>
  <a href="/blog/">Blog</a>
  <a href="/about/">About</a>
</div>

<main id="main">
{{ content | safe }}
</main>

