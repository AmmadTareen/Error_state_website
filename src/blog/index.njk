      {%- endfor %}
    </nav>

    <div class="plist" id="postList">
      {%- for post in collections.posts %}
      {% include "card.njk" %}
      {%- endfor %}
    </div>

    <p class="plist__empty" id="postEmpty" hidden>No posts carry that tag yet.</p>

    <p class="note" style="margin-top:clamp(32px,4vw,56px);text-align:center">
      Subscribe with <a href="/blog/rss.xml">RSS</a>.
    </p>
  </div>
